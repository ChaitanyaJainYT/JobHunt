# Tip: run `python agent.py setup` instead of filling this by hand — it opens
# each key page below, validates your pastes, and saves incrementally.
# Keys accept comma-separated values for rotation: KEY=k1,k2
# --- LLM (get: https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=
# Optional fallback, auto-used on Gemini quota (get: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODEL=gemini-3.6-flash

# --- RapidAPI (subscribe free: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch,
# key is under the API's Security tab; rotation helps across accounts only) ---
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com
# Allow override without code change
RAPIDAPI_JOB_ENDPOINT=https://jsearch.p.rapidapi.com/job-details
RAPIDAPI_SEARCH_ENDPOINT=https://jsearch.p.rapidapi.com/search-v2
RAPIDAPI_COUNTRY=in

# --- Google (sheet: https://sheets.google.com, paste URL or ID) ---
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json
# token.json is auto-created after first OAuth, do not pre-fill

# Name used in tailored resume filenames: <COMPANY>_<Name>_Resume_<DDMMYY>.pdf
APPLICANT_NAME=Chaitanya Jain

# LinkedIn supplement (optional): profile.md is read automatically if present;
# a public profile URL adds headline/about (Skills need login, rarely public).
LINKEDIN_PROFILE_URL=
LINKEDIN_PROFILE_FILE=profile.md
