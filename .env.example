# --- LLM ---
GEMINI_API_KEY=
# Optional fallback (auto-used when Gemini hits quota; free at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODEL=gemini-3.6-flash

# --- RapidAPI (JSearch default free tier) ---
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com
# Allow override without code change
RAPIDAPI_JOB_ENDPOINT=https://jsearch.p.rapidapi.com/job-details

# --- Google ---
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json
# token.json is auto-created after first OAuth, do not pre-fill
